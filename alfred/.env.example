# ============================================================
# Alfred — Environment Variables
# Copy to .env and fill in the values.
# NEVER commit .env to git.
# ============================================================

# Application
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO

# Database (Docker Compose default)
POSTGRES_PASSWORD=alfred_dev
DATABASE_URL=postgresql+asyncpg://alfred:alfred_dev@localhost:5432/alfred

# WhatsApp Business Cloud API
# Obtido em: Meta for Developers → App → WhatsApp → Configuration
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=dev_verify_token   # escolha uma string aleatória em prod
WHATSAPP_APP_SECRET=                      # usado para validar HMAC-SHA256
WHATSAPP_PHONE_NUMBER_ID=

# LLM Provider
# bedrock (AWS Frankfurt eu-central-1) ou azure_openai (EU zone)
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
LLM_API_KEY=

# AWS (necessário se LLM_PROVIDER=bedrock)
AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=       # não use em prod — use IAM role / Secrets Manager
# AWS_SECRET_ACCESS_KEY=

# Security
SECRET_KEY=change-me-in-production   # gere com: openssl rand -hex 32
