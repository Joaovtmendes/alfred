# ============================================================
# Alfred — variáveis de ambiente
# Copia para .env e preenche. NUNCA commitar o .env.
# Em produção, as mesmas variáveis vivem no Railway (serviço web + alfred-cron).
# ============================================================

# App
ENVIRONMENT=development            # development | production (production desliga /docs)
LOG_LEVEL=INFO
TIMEZONE=Europe/Amsterdam          # "hoje", semanas e horas de lembretes
BASE_URL=http://localhost:8000     # prod: https://alfred-production-5d54.up.railway.app (links do dashboard)

# Base de dados (default = docker compose)
POSTGRES_PASSWORD=alfred_dev
DATABASE_URL=postgresql+asyncpg://alfred:alfred_dev@localhost:5432/alfred

# WhatsApp Business Cloud API — Meta for Developers → App → WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=             # string aleatória; a mesma no painel da Meta
WHATSAPP_APP_SECRET=               # OBRIGATÓRIO: sem ele o webhook rejeita tudo (401)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=                  # scripts/submit_templates.py
GRAPH_API_VERSION=v25.0            # Meta Graph API (v19 expirou em 05/2026)

# LLM
LLM_PROVIDER=anthropic             # anthropic | bedrock (bedrock requer pip install -e ".[bedrock]")
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=                       # chave da Anthropic
LLM_TIMEOUT_SECONDS=20

# Só para LLM_PROVIDER=bedrock
AWS_REGION=eu-central-1

# Cron (serviço alfred-cron)
CRON_INTERVAL_MINUTES=15           # tem de bater com o schedule do Railway (*/15 * * * *)

# Reservado (ainda não usado pelo código)
SECRET_KEY=                        # openssl rand -hex 32

# Nota: o GITHUB_TOKEN do MCP do Claude NÃO vai aqui — exporta-o no teu shell
# (ex.: ~/.zshrc) para o Claude Code o ler ao abrir o projecto.
